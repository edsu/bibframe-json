    "Node": {
      "additionalProperties": {
        "$comment": "A property with no field in the models is still a property, so it is still an array. Without this the guarantee holds only for the properties that happen to be modelled.",
        "type": "array"
      },
      "description": "Anything with a @type and properties: the shape all of these share.",
      "properties": {
        "@id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "@Id"
        },
